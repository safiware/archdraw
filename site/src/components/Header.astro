---
import Logo from './Logo.astro';
interface Props { home?: boolean }
const { home = true } = Astro.props;
// On other pages the section links point back to the landing page.
const base = home ? '' : '/';
---
<a class="skip" href="#main">Skip to content</a>
<header class="top wrap">
  <a class="brand" href="/" aria-label="archdraw home"><Logo /><span>archdraw</span></a>
  <nav aria-label="Main">
    <a href={`${base}#how`}>How it works</a><a href={`${base}#review`}>Review</a><a href={`${base}#private`}>Privacy</a><a href={`${base}#agents`}>For agents</a>
  </nav>
  <div class="top-act">
    <a class="icon-btn gh-t" href="https://github.com/safiware/archdraw" aria-label="archdraw on GitHub" title="archdraw on GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg></a>
    <button class="icon-btn theme-t" type="button" aria-label="Switch theme">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
    </button>
    <a class="btn btn-lamp btn-sm" href={`${base}#get`}>Install</a>
  </div>
</header>
<script>
  import { initTheme } from '../scripts/theme';
  initTheme();
</script>
