---
import Diagram from './Diagram.astro';
import Logo from './Logo.astro';
import InstallCommand from './InstallCommand.astro';
import { AFTER_LABEL, contours } from '../lib/diagram';
import { VB_AFTER } from '../lib/bean';
const RELEASES = 'https://github.com/safiware/archdraw/releases/latest';
---
<section class="hero" aria-labelledby="hero-h">
  <div class="contours" aria-hidden="true" set:html={contours()} />
  <div class="wrap">
    <p class="eyebrow"><span class="live-dot" aria-hidden="true"></span><span>Architecture diagrams that never go stale</span></p>
    <h1 class="hero-h" id="hero-h"><span class="l">Keep the drawing</span> <span class="l">true to the <span class="em">code.</span></span></h1>
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="lede">archdraw keeps your architecture diagram up to date as the code changes, whether the change came from you, a teammate, or an AI agent. It notices when the drawing no longer matches, draws the update, and waits for your OK.</p>
        <div class="ctas">
          <InstallCommand />
        </div>
        <p class="fine">For macOS 13+ and Linux. <a href="https://github.com/safiware/archdraw/blob/main/site/public/install.sh">Read the script</a> · <a href={RELEASES}>Or download the files</a><br />Free, with the source on GitHub. Runs on your AI key; you set the spending cap.</p>
      </div>
      <div class="hero-live">
        <div class="win">
          <div class="win-bar"><span class="mono">bean-there (example) / overview.archdraw</span><span class="pill" id="hero-pill"><i></i><span>in step with the code · checked <time id="hero-time">10:00</time></span></span></div>
          <div class="stage-scroll" role="region" aria-label="Example diagram, scrolls sideways" tabindex="0" data-name="Example diagram" data-focus="0.66"><div class="stage hero-stage">
            <div class="glow-wrap" aria-hidden="true"><Diagram mode="after" uid="hg" cls="glowcopy" /></div>
            <svg class="pts" viewBox={VB_AFTER} aria-hidden="true"></svg>
            <Diagram mode="after" uid="hd" flash cls="hero-dg" label={AFTER_LABEL} />
            <div class="scan" aria-hidden="true"></div>
          </div></div>
          <p class="swipe">Swipe to see the whole drawing.</p>
          <div class="ticker">
            <div class="ticker-h mono"><span>Changes landing</span><span class="ticker-r"><span>you · Maya · coding agent</span><button class="hold" type="button" aria-pressed="false"><svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3h2.4v10H4.5zM9.1 3h2.4v10H9.1z"/></svg><svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 2.8 13 8l-8.5 5.2z"/></svg><span class="hold-t">Pause motion</span></button></span></div>
            <ol class="tick-list" id="ticks" aria-label="Recent changes, newest first">
              <li class="tk who-you"><span class="av" aria-hidden="true">Y</span><span class="tk-t"><b>You</b>approved the update. The drawing is true again.</span><time>10:05</time></li>
              <li class="tk who-arch"><span class="av" aria-hidden="true"><Logo /></span><span class="tk-t"><b>archdraw</b>drew one update: 2 added, 1 changed, 1 removed.</span><time>10:00</time></li>
              <li class="tk who-agent"><span class="av" aria-hidden="true">AI</span><span class="tk-t"><b>Coding agent</b>removed fax orders.</span><time>09:40</time></li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .hero { position: relative; overflow: hidden; padding-block: clamp(20px, 4vh, 44px) clamp(48px, 8vh, 96px); isolation: isolate; }
  .contours { position: absolute; top: -80px; right: -10%; bottom: 0; width: min(1500px, 120vw); z-index: -1; pointer-events: none; overflow: hidden; }
  .contours svg { width: 100%; height: 100%; display: block; will-change: transform; transform-origin: 70% 40%; animation: drift 40s ease-in-out infinite alternate; }
  @keyframes drift { to { transform: translate(-40px, 18px) rotate(4deg); } }
  .hero.off .contours svg, .hero.off .glowcopy, .hero.off .live-dot { animation-play-state: paused; }
  .contours path { fill: none; stroke: var(--contour); stroke-width: 1.2; }
  .hero::before { content: ""; position: absolute; z-index: -2; inset: 0; background: radial-gradient(60% 70% at 78% 52%, var(--signal-soft), transparent 70%); }
  .hero-h { font-size: clamp(2.45rem, 7.4vw, 6rem); font-weight: 800; letter-spacing: -0.025em; line-height: .98; margin-top: 18px; max-width: 13.5em; }
  .hero-h .l { display: block; }
  .hero-h .em { color: var(--signal); }
  @media (max-width: 700px) { .hero-h .l { display: inline; } }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 5.2fr) minmax(0, 6.8fr); gap: clamp(24px, 4vw, 56px); margin-top: clamp(24px, 4vh, 40px); align-items: start; }
  .lede { font-size: clamp(1.06rem, 1.35vw, 1.2rem); line-height: 1.62; max-width: 34em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px 12px; margin-top: 26px; max-width: 560px; }
  .ctas .install-cmd { flex: 1 1 100%; }
  .fine a { color: var(--signal); text-underline-offset: 3px; }
  .fine { margin-top: 18px; font-size: .9rem; color: var(--text-2); }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: minmax(0, 1fr); } }

  .hero-stage { padding: 6px 12px 0; overflow: hidden; }
  .glow-wrap { position: absolute; inset: 6px 12px 0; opacity: calc(.7 * var(--glow-a)); pointer-events: none; }
  @media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) .glow-wrap { display: none; } }
  :root[data-theme="light"] .glow-wrap { display: none; }
  .glow-wrap .glowcopy { filter: blur(7px); will-change: opacity; animation: breathe 2.8s ease-in-out infinite alternate; }
  @keyframes breathe { to { opacity: .35; } }
  .glowcopy text, .glowcopy .lbl-bg, .glowcopy .ico { display: none; }
  .glowcopy .edge { stroke: var(--signal); stroke-width: 4; }
  .glowcopy .box { fill: none; stroke: var(--signal); stroke-width: 5; }
  .hero-stage .pts { inset: 6px 12px 0; width: calc(100% - 24px); }
  .scan { position: absolute; top: 0; bottom: 0; left: 0; width: 90px; pointer-events: none; opacity: 0; background: linear-gradient(90deg, transparent, var(--signal-soft) 70%, color-mix(in srgb, var(--signal) 50%, transparent) 98%, transparent); will-change: transform, opacity; }
  .dg .fl.who-you { stroke: var(--you); } .dg .fl.who-mate { stroke: var(--mate); } .dg .fl.who-agent { stroke: var(--agent); } .dg .fl.who-arch { stroke: var(--lamp); }

  .ticker { border-top: 1px solid var(--rule); padding: 10px 16px 12px; background: color-mix(in srgb, var(--well) 55%, transparent); }
  .ticker-h { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 12px; color: var(--text-2); font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 6px; }
  .ticker-r { display: inline-flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .hold { display: inline-flex; align-items: center; gap: 6px; min-height: 28px; padding: 4px 9px; border: 1.5px solid var(--rule); border-radius: 7px; background: var(--panel); color: var(--text); font: 600 .62rem/1 var(--f-mono); letter-spacing: .04em; text-transform: uppercase; cursor: pointer; }
  .hold svg { width: 11px; height: 11px; fill: currentColor; }
  .hold .i-play, .hold[aria-pressed="true"] .i-pause { display: none; }
  .hold[aria-pressed="true"] .i-play { display: block; }
  html:not(.js) .hold { display: none; }
  @media (prefers-reduced-motion: reduce) { .hold { display: none; } }
  .tick-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .tk { display: grid; grid-template-columns: 26px minmax(0, 1fr) auto; gap: 10px; align-items: center; font-size: .9rem; line-height: 1.35; padding: 3px 0; }
  .tk b { font-weight: 700; margin-right: .35em; }
  .tk time { font: .68rem var(--f-mono); color: var(--text-2); }
  .tk-t { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 520px) {
    .tk-t { white-space: normal; }
    /* three rows of two lines each: keep the box from growing as rows change */
    .tick-list { min-height: calc(3 * 2 * 1.35 * .9rem + 3 * 6px + 8px); align-content: start; }
  }
</style>

<script>
  import { initHero } from '../scripts/hero';
  initHero();
</script>
